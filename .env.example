# Upstream protocol: openai translates Messages; anthropic relays it.
UPSTREAM_PROTOCOL=openai
UPSTREAM_BASE_URL=https://gateway.example.com/openai/v1
# Optional separate origin when model discovery is not served below the inference base.
# UPSTREAM_MODELS_BASE_URL=https://catalog.example.com/openai/v1
# OPENAI_API=chat_completions
# OPENAI_API=responses
UPSTREAM_CHAT_PATH=/chat/completions
UPSTREAM_RESPONSES_PATH=/responses
UPSTREAM_RESPONSES_INPUT_TOKENS_PATH=/responses/input_tokens
UPSTREAM_MESSAGES_PATH=/messages
UPSTREAM_MODELS_PATH=/models

# apiKeyHelper sends credentials to this proxy. Choose the upstream representation.
AUTH_MODE=passthrough
# AUTH_MODE=bearer
# AUTH_MODE=api-key
# AUTH_MODE=x-api-key

# Leave both unset to pass through the model selected by Claude Code.
# Use MODEL_OVERRIDE only when every request must target one upstream deployment.
# MODEL_OVERRIDE=example-deployment
# MODEL_MAP='{"claude-sonnet-*":"coding-deployment","claude-haiku-*":"fast-deployment"}'
# Static Claude-visible aliases for opt-in gateway model discovery.
# MODEL_DISCOVERY='{"claude-gpt-5-6-sol":"GPT-5.6 Sol"}'
# Or fetch an OpenAI-compatible model list and create reversible claude-proxy-* aliases.
# MODEL_DISCOVERY_MODE=auto
# MODEL_DISCOVERY_INCLUDE=gateway-gpt-*,gateway-kimi-*,gateway-gemini-*
# MODEL_DISCOVERY_EXCLUDE=*embedding*,*audio*,*image*

# Claude output_config.effort (and legacy top-level effort) is translated to
# Chat reasoning_effort or Responses reasoning.effort by default.
REASONING_EFFORT_ENABLED=true
# Override only levels that the selected upstream does not accept. null omits a level.
# REASONING_EFFORT_MAP='{"xhigh":"high","max":"high"}'

# Optional enterprise gateway configuration.
# UPSTREAM_QUERY=api-version=2024-10-21
# UPSTREAM_HEADERS_JSON={"x-gateway-tenant":"example"}
# FORWARD_HEADERS=x-request-id,x-correlation-id,traceparent,tracestate
# OPENAI_FORWARD_HEADERS=idempotency-key,openai-organization,openai-project
# ANTHROPIC_FORWARD_HEADERS=anthropic-version,anthropic-beta,anthropic-workspace-id
# MAX_TOKENS_FIELD=max_completion_tokens
# Some gateways require 16 even when Claude sends a one-token model-selection probe.
# MIN_OUTPUT_TOKENS=16

REQUEST_TIMEOUT=600
CONNECT_TIMEOUT=10
MAX_REQUEST_BODY_BYTES=33554432
MAX_RESPONSE_BODY_BYTES=33554432
MAX_ERROR_BODY_BYTES=65536
STREAM_PING_INTERVAL=15
VERIFY_SSL=true
PASSTHROUGH_ENABLED=true
PASSTHROUGH_STRIP_PREFIX=/v1
TOKEN_COUNT_MODE=auto
TOKEN_COUNT_FALLBACK=unsupported

HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO

# Optional maintainer-only live conformance target (not proxy runtime settings).
# LIVE_RESPONSES_BASE_URL=https://gateway.example.com/openai/v1
# LIVE_RESPONSES_MODEL=deployment-name
# LIVE_RESPONSES_API_KEY=replace-me
# LIVE_RESPONSES_AUTH_MODE=bearer
# LIVE_RESPONSES_UPSTREAM_QUERY=api-version=2026-01-01
# LIVE_RESPONSES_PROBES=1

# Static auth is intentionally not populated. Inject the key through a secrets manager.
# AUTH_MODE=static
# UPSTREAM_API_KEY=
# UPSTREAM_API_KEY_HEADER=api-key
# UPSTREAM_API_KEY_SCHEME=
